{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "keywords/<slug>.json — 대표 키워드 1개의 30일 추이·기사·근거",
  "description": "프론트는 이 파일로 /articles, /history, /history/compare, /history/evidence 응답을 만든다",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "keyword", "slug", "aliases", "searchKeywords", "timezone", "today", "generatedAt", "daily", "articles", "evidenceByDay"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "keyword": { "type": "string" },
    "slug": { "$ref": "common.schema.json#/$defs/slug" },
    "aliases": { "type": "array", "items": { "type": "string" } },
    "searchKeywords": { "type": "array", "items": { "type": "string" }, "description": "v1 resolveSearchKeywords 결과: 대표 키워드 + 승인 alias 원본들" },
    "timezone": { "const": "Asia/Seoul" },
    "today": { "$ref": "common.schema.json#/$defs/seoulDate" },
    "generatedAt": { "type": "string", "pattern": "Z$" },
    "daily": {
      "type": "array",
      "minItems": 30,
      "maxItems": 30,
      "description": "today-29 ~ today, 날짜 오름차순, 기사 없는 날도 0으로 포함",
      "items": { "$ref": "common.schema.json#/$defs/dailyPoint" }
    },
    "articles": {
      "type": "array",
      "maxItems": 100,
      "description": "최신 publishedAt 순",
      "items": { "$ref": "common.schema.json#/$defs/article" }
    },
    "evidenceByDay": {
      "type": "object",
      "propertyNames": { "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
      "additionalProperties": {
        "type": "array",
        "maxItems": 5,
        "items": { "$ref": "common.schema.json#/$defs/evidenceArticle" }
      }
    }
  }
}
