{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "keywords/index.json — 상세 파일이 있는 대표 키워드 색인",
  "description": "aliasToCanonical 의 키는 v1 KeywordNormalizer.normalize 결과: trim → 소문자 → 모든 공백 제거 → '.' 제거 → '-' 제거. 대표 키워드 자기 자신도 포함한다",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "generatedAt", "keywords", "aliasToCanonical"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "generatedAt": { "type": "string", "pattern": "Z$" },
    "keywords": {
      "type": "array",
      "maxItems": 3000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["keyword", "slug", "aliases", "mentionCount", "articleCount30d"],
        "properties": {
          "keyword": { "type": "string" },
          "slug": { "$ref": "common.schema.json#/$defs/slug" },
          "aliases": { "type": "array", "items": { "type": "string" } },
          "mentionCount": { "type": "integer", "minimum": 0, "description": "현재 24시간 고유 기사 수 (전 카테고리 합)" },
          "articleCount30d": { "type": "integer", "minimum": 0 }
        }
      }
    },
    "aliasToCanonical": {
      "type": "object",
      "additionalProperties": { "type": "string" }
    }
  }
}
