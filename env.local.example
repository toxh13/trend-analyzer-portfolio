# Crawling_Project local Docker env sample
# Copy this file to env.local before running local compose.
# env.local is ignored by git.

ORACLE_PASSWORD=change_me_local_only

DB_USERNAME=trend_app
DB_PASSWORD=trend_app_pw
DB_POOL_SIZE=5
DB_URL=jdbc:oracle:thin:@oracle-db:1521/FREEPDB1

CRAWLER_API_KEY=local-dev-crawler-key-change-me
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8080,http://localhost
DISCORD_BOT_TOKEN=

# Google OAuth2 local settings
# Google Cloud Console redirect URI:
# http://localhost:8080/login/oauth2/code/google
SPRING_SECURITY_OAUTH2_CLIENT_REGISTRATION_GOOGLE_CLIENT_ID=your-google-client-id
SPRING_SECURITY_OAUTH2_CLIENT_REGISTRATION_GOOGLE_CLIENT_SECRET=your-google-client-secret
SPRING_SECURITY_OAUTH2_CLIENT_REGISTRATION_GOOGLE_SCOPE=openid,email,profile
OAUTH2_SUCCESS_REDIRECT_URI=http://localhost:3000

# Discord account link local settings
# Discord Developer Portal redirect URI:
# http://localhost:8080/api/v1/me/discord/callback
DISCORD_OAUTH_CLIENT_ID=your-discord-client-id
DISCORD_OAUTH_CLIENT_SECRET=your-discord-client-secret
DISCORD_OAUTH_REDIRECT_URI=http://localhost:8080/api/v1/me/discord/callback
DISCORD_LINK_SUCCESS_REDIRECT_URI=http://localhost:3000/my-info
